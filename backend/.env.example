# Copy to backend/.env and fill in credentials. Empty model settings use config.py defaults.
GEMINI_API_KEY=
# Analysis model used by default. Override this placeholder as needed.
GEMINI_MODEL=gemini-3.6-flash
SUPPORT_CHECK_MODEL=
# One fallback attempt is available after repeated primary 503/504 responses.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
COURTLISTENER_TOKEN=
